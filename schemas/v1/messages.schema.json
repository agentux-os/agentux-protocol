{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentuxos.org/protocol/v1/messages.schema.json",
  "title": "AgentUX Protocol v1 messages",
  "type": "object",
  "$defs": {
    "baseParams": {
      "type": "object",
      "required": ["protocolVersion", "organizationId", "nodeId", "messageId", "occurredAt"],
      "properties": {
        "protocolVersion": {"const": "v1"},
        "organizationId": {"type": "string", "minLength": 1},
        "nodeId": {"type": "string", "minLength": 1, "maxLength": 128},
        "messageId": {"type": "string", "minLength": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "commandId": {"type": "string", "minLength": 1},
        "eventId": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "lastAcknowledgedSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "throughSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "requestedAfterSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "checkpointId": {"type": "string", "minLength": 1, "maxLength": 128},
        "acknowledgementType": {"enum": ["events", "snapshot_checkpoint"]},
        "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
        "pageToken": {"type": "string", "minLength": 1, "maxLength": 2048},
        "missionId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "sessionId": {"type": "string", "minLength": 1},
        "activity": {"$ref": "execution-activity.schema.json#/$defs/activity"},
        "node": {"$ref": "#/$defs/nodeState"},
        "alert": {"$ref": "#/$defs/nodeAlertEvent"}
      },
      "additionalProperties": true
    },
    "agentIsolation": {
      "description": "Effective agent-session isolation, reported by the node after a run's first agent session opens.",
      "type": "object",
      "required": ["mode", "source"],
      "properties": {
        "mode": {"description": "Weakest effective session mode in the run: host (`none`) is less isolated than `bubblewrap`.", "enum": ["none", "bubblewrap"]},
        "network": {"description": "For sandboxed runs, the weakest network restriction used by any session: `outbound` is less isolated than `none`.", "enum": ["outbound", "none"]},
        "source": {"description": "Among sessions that establish the run's weakest mode/network, the source with highest precedence: node-policy, project, command, then default.", "enum": ["project", "node-policy", "command", "default"]}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "bubblewrap"}}, "required": ["mode"]}, "then": {"required": ["network"]}},
        {"if": {"properties": {"mode": {"const": "none"}}, "required": ["mode"]}, "then": {"not": {"required": ["network"]}}}
      ],
      "additionalProperties": false
    },
    "nodeState": {
      "type": "object",
      "required": ["nodeId", "status", "capacity"],
      "properties": {
        "nodeId": {"type": "string", "minLength": 1, "maxLength": 128},
        "status": {"enum": ["ready", "draining", "error"]},
        "capacity": {"type": "object"}
      },
      "additionalProperties": false
    },
    "nodeAlertState": {
      "type": "object",
      "required": ["alertId", "producer", "code", "conditionKey", "summary", "firstObservedAt", "lastObservedAt", "status"],
      "properties": {
        "alertId": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "conditionKey": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
        "firstObservedAt": {"type": "string", "format": "date-time"},
        "lastObservedAt": {"type": "string", "format": "date-time"},
        "status": {"enum": ["active", "resolved"]}
      },
      "additionalProperties": false
    },
    "nodeAlertEvent": {
      "oneOf": [
        {"type": "object", "required": ["kind", "alert"], "properties": {"kind": {"const": "state"}, "alert": {"$ref": "#/$defs/nodeAlertState"}}, "additionalProperties": false},
        {"type": "object", "required": ["kind", "alertId"], "properties": {"kind": {"const": "removed"}, "alertId": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      ]
    },
    "resumeResult": {
      "description": "Command invokes node.resume on the node; replayed node notifications are sent to Command on the event channel, never returned in this result.",
      "type": "object",
      "required": ["status", "nodeId", "requestedAfterSequence", "oldestAvailableSequence", "highWaterSequence", "eventsReplayed", "snapshotRequired"],
      "properties": {
        "status": {"enum": ["replay", "cursor_expired"]},
        "nodeId": {"type": "string", "minLength": 1},
        "requestedAfterSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "oldestAvailableSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "highWaterSequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "eventsReplayed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "snapshotRequired": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "cursor_expired"}}, "required": ["status"]}, "then": {"properties": {"snapshotRequired": {"const": true}, "eventsReplayed": {"const": 0}}}},
        {"if": {"properties": {"status": {"const": "replay"}}, "required": ["status"]}, "then": {"required": ["snapshotRequired"], "properties": {"snapshotRequired": {"const": false}}}}
      ],
      "additionalProperties": false
    },
    "nodeSnapshotResult": {"$ref": "node-snapshot.schema.json#/$defs/page"},
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"type": "string", "minLength": 1},
        "params": {"$ref": "#/$defs/baseParams"}
      },
      "additionalProperties": false
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "method": {"type": "string", "minLength": 1},
        "params": {"$ref": "#/$defs/baseParams"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "node.hello"}, "params": {"required": ["capabilities", "agentuxVersion", "supportedProtocolVersions"]}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"const": "node.heartbeat"}, "params": {"required": ["status", "capacity"], "not": {"anyOf": [{"required": ["eventId"]}, {"required": ["sequence"]}]}}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "node.resume"}, "params": {"required": ["commandId", "lastAcknowledgedSequence"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "run.start"}, "params": {"required": ["commandId", "missionId", "runId", "repository", "prompt", "pipeline", "roles", "budget", "isolationPolicy", "requestedCapabilities"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"enum": ["run.cancel", "run.pause", "run.resume"]}, "params": {"required": ["commandId", "runId"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "request.resolve"}, "params": {"required": ["commandId", "runId", "requestId", "resolution"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "run.snapshot"}, "params": {"required": ["commandId", "runId"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "bus.post"}, "params": {"required": ["commandId", "runId", "message"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "harness.list"}, "params": {"required": ["commandId"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "harness.test"}, "params": {"required": ["commandId", "harness"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "limits.clear"}, "params": {"required": ["commandId", "harness"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "preferences.set"}, "params": {"required": ["commandId", "preferences"]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "node.events.ack"}, "params": {"required": ["commandId", "throughSequence"], "allOf": [{"if": {"properties": {"acknowledgementType": {"const": "snapshot_checkpoint"}}, "required": ["acknowledgementType"]}, "then": {"required": ["checkpointId"]}}, {"if": {"required": ["checkpointId"]}, "then": {"properties": {"acknowledgementType": {"const": "snapshot_checkpoint"}}}}]}}}]},
    {"allOf": [{"$ref": "#/$defs/request"}, {"properties": {"method": {"const": "node.snapshot"}, "params": {"required": ["commandId", "checkpointId", "requestedAfterSequence", "pageSize"]}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"const": "node.status_changed"}, "params": {"required": ["eventId", "sequence", "node"], "properties": {"node": {"$ref": "#/$defs/nodeState"}}}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"const": "node.alert"}, "params": {"required": ["eventId", "sequence", "alert"], "properties": {"alert": {"$ref": "#/$defs/nodeAlertEvent"}}}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"enum": ["run.accepted", "run.started", "session.event", "approval.requested", "gate.completed", "artifact.available", "harness.status", "harness.limits_changed", "command.denied", "command.completed"]}, "params": {"required": ["eventId", "sequence"]}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"enum": ["run.updated", "run.completed", "run.failed"]}, "params": {"required": ["eventId", "sequence"], "properties": {"agentIsolation": {"$ref": "#/$defs/agentIsolation"}}}}}]},
    {"allOf": [{"$ref": "#/$defs/notification"}, {"properties": {"method": {"const": "execution.activity"}, "params": {"required": ["eventId", "sequence", "activity"], "properties": {"activity": {"$ref": "execution-activity.schema.json#/$defs/activity"}}}}}]}
  ]
}
