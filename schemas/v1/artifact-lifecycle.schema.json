{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentuxos.org/protocol/v1/artifact-lifecycle.schema.json",
  "title": "AUXP v1 authenticated artifact retrieval",
  "$defs": {
    "getParams": {
      "type": "object",
      "required": ["protocolVersion", "organizationId", "nodeId", "messageId", "occurredAt", "commandId", "artifactId", "sha256", "offset", "maxBytes"],
      "properties": {
        "protocolVersion": {"const": "v1"}, "organizationId": {"type": "string", "minLength": 1},
        "nodeId": {"type": "string", "minLength": 1, "maxLength": 128}, "messageId": {"type": "string", "minLength": 1},
        "occurredAt": {"type": "string", "format": "date-time"}, "commandId": {"type": "string", "minLength": 1},
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "offset": {"type": "integer", "minimum": 0, "maximum": 26214400}, "maxBytes": {"type": "integer", "minimum": 1, "maximum": 262144}
      },
      "additionalProperties": false
    },
    "chunkResult": {
      "type": "object", "required": ["artifactId", "sha256", "mediaType", "byteLength", "offset", "dataBase64"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 128}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 127}, "byteLength": {"type": "integer", "minimum": 0, "maximum": 26214400},
        "offset": {"type": "integer", "minimum": 0, "maximum": 26214400},
        "dataBase64": {"type": "string", "maxLength": 349528, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
      },
      "additionalProperties": false
    },
    "artifactState": {
      "type": "object", "required": ["artifactId", "organizationId", "runId", "revision", "mediaType", "byteLength", "uri"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1, "maxLength": 128}, "organizationId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1, "maxLength": 128}, "revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 127}, "byteLength": {"type": "integer", "minimum": 0, "maximum": 26214400},
        "uri": {"type": "string", "maxLength": 2048, "pattern": "^artifact://[^/]+/[^/]+/[a-f0-9]{64}$"}
      }, "additionalProperties": false
    }
  }
}
